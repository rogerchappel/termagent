{
  "name": "termagent",
  "version": "0.1.0",
  "description": "Local-first CLI for inspecting terminal-agent session fixtures and exporting proof bundles.",
  "type": "module",
  "bin": {
    "termagent": "./dist/src/index.js"
  },
  "files": [
    "dist",
    "docs",
    "examples",
    "scripts",
    "SKILL.md",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "test": "node --test dist/tests/*.test.js",
    "pretest": "npm run build",
    "smoke": "bash scripts/smoke.sh",
    "validate": "bash scripts/validate.sh",
    "package:smoke": "bash scripts/package-smoke.sh",
    "release:check": "npm run check && npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "cli",
    "terminal-agent",
    "audit",
    "proof-bundle",
    "local-first",
    "transcripts",
    "approvals"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/termagent.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/termagent/issues"
  },
  "homepage": "https://github.com/rogerchappel/termagent#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.15.17",
    "typescript": "^5.8.3"
  }
}
